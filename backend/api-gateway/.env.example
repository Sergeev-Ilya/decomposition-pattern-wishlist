PORT=8080
AUTH_SERVICE_URL=http://auth-service:3000
WISHLIST_SERVICE_URL=http://wishlist-service:3000
APP_ORIGIN=http://localhost:8880
# Supply the same independently generated >=32-byte credential to all three services.
INTERNAL_TOKEN=
UPSTREAM_TIMEOUT_MS=5000
# Empty means socket IP only. Explicit comma-separated IPs, no CIDRs or hop counts.
# A configured nginx must overwrite X-Forwarded-For with one client IP.
TRUSTED_PROXY_IPS=

PORT=3000
DATABASE_URL=postgresql://<auth-user>:<auth-password>@auth-db:5432/wishlist_auth
# Generate separate random values of at least 32 bytes; no built-in secrets.
JWT_SECRET=
INTERNAL_TOKEN=
# false only for the agreed HTTP localhost deployment; true for HTTPS.
COOKIE_SECURE=false
NODE_ENV=development
# Optional, explicitly disposable PostgreSQL integration database; never DATABASE_URL.
# TEST_DATABASE_URL=postgresql://<test-user>:<test-password>@127.0.0.1:55432/wishlist_auth_test
